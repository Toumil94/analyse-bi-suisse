/// Demande : arrivées et nuitées par mois, canton et pays de provenance.
table fact_demande
	lineageTag: 41407953-31f3-5aa7-a401-ba43f78b509e

	column canton_id
		dataType: string
		isHidden
		lineageTag: 187957d5-8668-5c59-92e4-59113c123b23
		summarizeBy: none
		sourceColumn: canton_id

		annotation SummarizationSetBy = Automatic

	column pays_id
		dataType: string
		isHidden
		lineageTag: c289dfe8-db2f-5b82-a0bf-a1bc640e6121
		summarizeBy: none
		sourceColumn: pays_id

		annotation SummarizationSetBy = Automatic

	column arrivees
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 65e3693d-25d2-5749-93ae-aa36ad511a29
		summarizeBy: sum
		sourceColumn: arrivees

		annotation SummarizationSetBy = Automatic

	column nuitees
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 7045950f-e15d-5ef8-97c9-2a4ca0d406d3
		summarizeBy: sum
		sourceColumn: nuitees

		annotation SummarizationSetBy = Automatic

	column 'date'
		dataType: dateTime
		isHidden
		formatString: Short Date
		lineageTag: 4a1bd81b-dd26-5809-9586-f039f0c85780
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition fact_demande = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents(BaseUrl, [RelativePath = "fact_demande.csv"]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"date_key", type text}, {"canton_id", type text}, {"pays_id", type text}, {"arrivees", Int64.Type}, {"nuitees", Int64.Type}}, "en-US"),
				    AvecDate = Table.AddColumn(Types, "date", each #date(Number.FromText(Text.Start([date_key], 4)), Number.FromText(Text.Middle([date_key], 4, 2)), 1), type date),
				    SansCle = Table.RemoveColumns(AvecDate, {"date_key"})
				in
				    SansCle

	annotation PBI_ResultType = Table
