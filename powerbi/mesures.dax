// =============================================================================
// Mesures DAX du rapport « Tourisme hôtelier en Suisse »
// Fichier généré par build_pbip.py : elles sont déjà dans Tourisme-Suisse.pbip.
// =============================================================================

// ----- Table calendrier (table calculée, marquée comme table de dates) -----
// Les faits sont mensuels (au 1er du mois) : un calendrier journalier continu est
// nécessaire pour que les fonctions d'intelligence temporelle fonctionnent.

Calendrier = CALENDAR ( DATE ( 2005, 1, 1 ), EOMONTH ( MAX ( fact_offre[date] ), 0 ) )
Calendrier[Année] = YEAR ( [Date] )
Calendrier[Mois] = MONTH ( [Date] )
Calendrier[Mois nom] = FORMAT ( [Date], "mmm" )
Calendrier[Mois début] = DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 )
Calendrier[Année-mois] = FORMAT ( [Date], "yyyy-mm" )
Calendrier[Trimestre] = "T" & QUARTER ( [Date] )
Calendrier[Saison] = IF ( MONTH ( [Date] ) IN { 11, 12, 1, 2, 3, 4 }, "Hiver", "Été" )
Calendrier[Période COVID] = SWITCH (
    TRUE (),
    [Date] < DATE ( 2020, 3, 1 ), "1. Avant COVID",
    [Date] <= DATE ( 2021, 12, 31 ), "2. COVID",
    "3. Après COVID"
)

// ----- Volumes ---------------------------------------------------------------

// Nombre de nuits passées à l'hôtel.  (format : #,0)
Nuitées = SUM ( fact_demande[nuitees] )

// Nombre de clients arrivés.  (format : #,0)
Arrivées = SUM ( fact_demande[arrivees] )

// Nuitées par arrivée, en nuits.  (format : 0.00)
Durée moyenne de séjour = DIVIDE ( [Nuitées], [Arrivées] )

// Nuitées des clients domiciliés hors de Suisse.  (format : #,0)
Nuitées étrangères = CALCULATE ( [Nuitées], dim_pays[continent] <> "Suisse" )

// Part des nuitées faites par des clients domiciliés à l'étranger.  (format : 0.0%)
Part des visiteurs étrangers = DIVIDE ( [Nuitées étrangères], [Nuitées] )

// ----- Occupation ------------------------------------------------------------

// Recalculé à partir de ses composantes (jamais une moyenne de taux) : retrouve le taux publié par l'OFS.  (format : 0.0%)
Taux d'occupation des chambres = DIVIDE ( SUM ( fact_offre[nuitees_chambres] ), SUM ( fact_offre[capacite_chambres_jours] ) )

// Nuitées rapportées aux lits-jours offerts.  (format : 0.0%)
Taux d'occupation des lits = DIVIDE ( SUM ( fact_offre[nuitees] ), SUM ( fact_offre[capacite_lits_jours] ) )

// Même taux, tous cantons confondus, pour comparer.  (format : 0.0%)
Taux d'occupation des chambres (Suisse) = CALCULATE ( [Taux d'occupation des chambres], REMOVEFILTERS ( dim_canton ) )

// Nombre moyen de chambres offertes par mois.  (format : #,0)
Chambres offertes (moyenne mensuelle) = AVERAGEX ( VALUES ( Calendrier[Année-mois] ), CALCULATE ( SUM ( fact_offre[chambres] ) ) )

// Nombre moyen d'hôtels ouverts par mois.  (format : #,0)
Établissements ouverts (moyenne mensuelle) = AVERAGEX ( VALUES ( Calendrier[Année-mois] ), CALCULATE ( SUM ( fact_offre[etablissements] ) ) )

// En points de pourcentage.  (format : +0.0;-0.0;0.0)
Écart d'occupation vs Suisse (points) = ( [Taux d'occupation des chambres] - [Taux d'occupation des chambres (Suisse)] ) * 100

// ----- Temps -----------------------------------------------------------------

// Mêmes jours, un an plus tôt.  (format : #,0)
Nuitées A-1 = CALCULATE ( [Nuitées], SAMEPERIODLASTYEAR ( Calendrier[Date] ) )

// Variation par rapport à la même période de l'année précédente.  (format : +0.0%;-0.0%;0.0%)
Évolution vs A-1 = DIVIDE ( [Nuitées] - [Nuitées A-1], [Nuitées A-1] )

// Depuis le 1er janvier.  (format : #,0)
Nuitées cumul annuel = TOTALYTD ( [Nuitées], Calendrier[Date] )

// Somme des 12 derniers mois : lisse la saisonnalité (vide avant décembre 2005).  (format : #,0)
Nuitées 12 mois glissants = VAR Fin = MAX ( Calendrier[Date] )
RETURN
    IF (
        Fin >= DATE ( 2005, 12, 31 ),
        CALCULATE ( [Nuitées], DATESINPERIOD ( Calendrier[Date], Fin, -12, MONTH ) )
    )

// Mêmes mois de 2019, dernière année avant le COVID.  (format : #,0)
Nuitées même période 2019 = VAR MoisSelectionnes = VALUES ( Calendrier[Mois] )
RETURN
    CALCULATE (
        [Nuitées],
        REMOVEFILTERS ( Calendrier ),
        Calendrier[Année] = 2019,
        TREATAS ( MoisSelectionnes, Calendrier[Mois] )
    )

// 100 % = niveau d'avant crise retrouvé.  (format : 0%)
Niveau vs 2019 = DIVIDE ( [Nuitées], [Nuitées même période 2019] )

// ----- Parts -----------------------------------------------------------------

// Part des nuitées suisses.  (format : 0.0%)
Part de marché du canton = DIVIDE ( [Nuitées], CALCULATE ( [Nuitées], REMOVEFILTERS ( dim_canton ) ) )

// Part des nuitées du canton.  (format : 0.0%)
Part du marché de provenance = DIVIDE ( [Nuitées], CALCULATE ( [Nuitées], REMOVEFILTERS ( dim_pays ) ) )

// Classement par nuitées.  (format : 0)
Rang du canton = IF (
    HASONEVALUE ( dim_canton[canton] ),
    RANKX ( ALL ( dim_canton[canton] ), [Nuitées], , DESC, DENSE )
)

// Points de croissance apportés par un marché.  (format : +0.0%;-0.0%;0.0%)
Contribution à la croissance = DIVIDE (
    [Nuitées] - [Nuitées A-1],
    CALCULATE ( [Nuitées A-1], REMOVEFILTERS ( dim_pays ) )
)

// ----- Affichage -------------------------------------------------------------

// Sous-titre dynamique des pages.
Titre période = VAR Debut = CALCULATE ( MIN ( fact_offre[date] ), ALLSELECTED ( Calendrier ) )
VAR Fin = CALCULATE ( MAX ( fact_offre[date] ), ALLSELECTED ( Calendrier ) )
RETURN
    SELECTEDVALUE ( dim_canton[canton], "Suisse" ) & " · de " & FORMAT ( Debut, "mmmm yyyy" ) & " à " & FORMAT ( Fin, "mmmm yyyy" )

// Fraîcheur des données.
Dernier mois disponible = "Données OFS jusqu'à " & FORMAT ( CALCULATE ( MAX ( fact_offre[date] ), REMOVEFILTERS () ), "mmmm yyyy" )

// Met Genève en rouge dans les classements.
Couleur canton = IF ( SELECTEDVALUE ( dim_canton[canton] ) = "Genève", "#D52B1E", "#B9BEC4" )
