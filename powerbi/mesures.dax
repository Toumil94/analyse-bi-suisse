// =============================================================================
// Mesures DAX du rapport « Tourisme hôtelier en Suisse »
// À créer dans une table vide nommée _Mesures (Accueil > Entrer des données > OK).
// Chaque bloc : nom de la mesure = formule. Format conseillé en commentaire.
// =============================================================================


// ----- Table calendrier (Modélisation > Nouvelle table) -----------------------
// Puis : clic droit sur la table > Marquer comme table de dates > colonne [Date].
// Les faits sont mensuels (au 1er du mois) : un calendrier journalier continu est
// nécessaire pour que les fonctions d'intelligence temporelle fonctionnent.

Calendrier =
ADDCOLUMNS (
    CALENDAR ( DATE ( 2005, 1, 1 ), EOMONTH ( MAX ( fact_offre[date] ), 0 ) ),
    "Année", YEAR ( [Date] ),
    "Mois", MONTH ( [Date] ),
    "Mois nom", FORMAT ( [Date], "mmm" ),
    "Année-mois", FORMAT ( [Date], "yyyy-mm" ),
    "Trimestre", "T" & QUARTER ( [Date] ),
    "Saison", IF ( MONTH ( [Date] ) IN { 11, 12, 1, 2, 3, 4 }, "Hiver", "Été" ),
    "Période COVID",
        SWITCH (
            TRUE (),
            [Date] < DATE ( 2020, 3, 1 ), "1. Avant COVID",
            [Date] <= DATE ( 2021, 12, 31 ), "2. COVID",
            "3. Après COVID"
        )
)


// ----- Volumes -----------------------------------------------------------------

Nuitées = SUM ( fact_demande[nuitees] )                                   // format : nombre entier, séparateur de milliers

Arrivées = SUM ( fact_demande[arrivees] )                                 // format : nombre entier

Durée moyenne de séjour =                                                  // format : décimal, 2 décimales (nuits)
DIVIDE ( [Nuitées], [Arrivées] )

Nuitées étrangères =
CALCULATE ( [Nuitées], dim_pays[continent] <> "Suisse" )

Part des visiteurs étrangers =                                             // format : pourcentage, 1 décimale
DIVIDE ( [Nuitées étrangères], [Nuitées] )


// ----- Capacité et occupation ----------------------------------------------------
// On ne fait jamais la moyenne de taux : on recalcule le taux à partir de ses composantes,
// sinon un petit canton pèserait autant que Zurich.

Taux d'occupation des chambres =                                           // format : pourcentage, 1 décimale
DIVIDE ( SUM ( fact_offre[nuitees_chambres] ), SUM ( fact_offre[capacite_chambres_jours] ) )

Taux d'occupation des lits =                                               // format : pourcentage, 1 décimale
DIVIDE ( SUM ( fact_offre[nuitees] ), SUM ( fact_offre[capacite_lits_jours] ) )

Chambres offertes (moyenne mensuelle) =                                    // format : nombre entier
AVERAGEX ( VALUES ( Calendrier[Année-mois] ), CALCULATE ( SUM ( fact_offre[chambres] ) ) )

Établissements ouverts (moyenne mensuelle) =
AVERAGEX ( VALUES ( Calendrier[Année-mois] ), CALCULATE ( SUM ( fact_offre[etablissements] ) ) )

Écart d'occupation vs Suisse (points) =                                    // format : décimal, 1 décimale
( [Taux d'occupation des chambres]
    - CALCULATE ( [Taux d'occupation des chambres], REMOVEFILTERS ( dim_canton ) ) ) * 100


// ----- Intelligence temporelle ---------------------------------------------------

Nuitées A-1 =
CALCULATE ( [Nuitées], SAMEPERIODLASTYEAR ( Calendrier[Date] ) )

Évolution vs A-1 =                                                         // format : pourcentage, 1 décimale
DIVIDE ( [Nuitées] - [Nuitées A-1], [Nuitées A-1] )

Nuitées cumul annuel =
TOTALYTD ( [Nuitées], Calendrier[Date] )

Nuitées 12 mois glissants =
CALCULATE (
    [Nuitées],
    DATESINPERIOD ( Calendrier[Date], MAX ( Calendrier[Date] ), -12, MONTH )
)

// Même période de 2019 (dernière année avant le COVID) : mêmes mois que le contexte courant.
Nuitées même période 2019 =
VAR MoisSelectionnes = VALUES ( Calendrier[Mois] )
RETURN
    CALCULATE (
        [Nuitées],
        REMOVEFILTERS ( Calendrier ),
        Calendrier[Année] = 2019,
        TREATAS ( MoisSelectionnes, Calendrier[Mois] )
    )

Niveau vs 2019 =                                                           // format : pourcentage, 0 décimale (100 % = niveau 2019 retrouvé)
DIVIDE ( [Nuitées], [Nuitées même période 2019] )


// ----- Parts et classements -------------------------------------------------------

Part de marché du canton =                                                 // format : pourcentage, 1 décimale
DIVIDE ( [Nuitées], CALCULATE ( [Nuitées], REMOVEFILTERS ( dim_canton ) ) )

Part du marché de provenance =                                             // format : pourcentage, 1 décimale
DIVIDE ( [Nuitées], CALCULATE ( [Nuitées], REMOVEFILTERS ( dim_pays ) ) )

Rang du canton =
IF (
    HASONEVALUE ( dim_canton[canton] ),
    RANKX ( ALL ( dim_canton[canton] ), [Nuitées], , DESC, DENSE )
)

// Combien un marché a contribué à la croissance totale (en points de %).
Contribution à la croissance =                                             // format : pourcentage, 1 décimale
DIVIDE (
    [Nuitées] - [Nuitées A-1],
    CALCULATE ( [Nuitées A-1], REMOVEFILTERS ( dim_pays ) )
)


// ----- Titres dynamiques ----------------------------------------------------------

Titre période =
VAR Debut = MIN ( Calendrier[Date] )
VAR Fin = CALCULATE ( MAX ( fact_offre[date] ), ALLSELECTED ( Calendrier ) )
RETURN
    "De " & FORMAT ( Debut, "mmmm yyyy" ) & " à " & FORMAT ( Fin, "mmmm yyyy" )

Dernier mois disponible =
"Données OFS jusqu'à " & FORMAT ( CALCULATE ( MAX ( fact_offre[date] ), REMOVEFILTERS () ), "mmmm yyyy" )
